{
  "$schema": "https://opencode.ai/config.json",
  "model": "ahe/mimo-v2.5",
  "providers": {
    "ahe": {
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://host.docker.internal:8766/trial/trial-a/v1",
        "apiKey": "ahe"
      },
      "models": {
        "mimo-v2.5": {
          "name": "mimo-v2.5",
          "tool_call": true,
          "limit": {
            "context": 1048576,
            "output": 384000
          },
          "settings": {
            "temperature": 0.6,
            "top_p": 0.95
          }
        }
      }
    },
    "_title_suppress": {
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://192.0.2.1:1",
        "apiKey": "noop"
      },
      "models": {
        "title-suppress": {
          "name": "title-suppress",
          "tool_call": false,
          "limit": {
            "context": 1,
            "output": 1
          }
        }
      }
    }
  },
  "permission": "allow",
  "share": "disabled",
  "small_model": "_title_suppress/title-suppress"
}